# ─────────────────────────────────────────────────────────────────────────────
# Ayan DJ Tools — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs.
# Le .env est chargé automatiquement par les scripts du dossier scripts/.
# ─────────────────────────────────────────────────────────────────────────────

# ── Soundcharts (source primaire d'enrichissement) ───────────────────────────
# Obtenez vos credentials sur https://soundcharts.com/
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=
# SOUNDCHARTS_BASE_URL=https://customer.api.soundcharts.com

# ── Spotify (fallback si Soundcharts indisponible) ───────────────────────────
# Créez une app sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Tavily (recherche web dans l'agent) ──────────────────────────────────────
# Obtenez une clé sur https://tavily.com/
TAVILY_API_KEY=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ayan
POSTGRES_USER=ayan
POSTGRES_PASSWORD=ayan

# ── Qdrant (vector store) ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6334

# ── Ollama (LLM local) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
