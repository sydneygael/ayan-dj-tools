# Spotify API — Tests manuels
# Flow: 1) Obtenir un token OAuth2 (Client Credentials), 2) Appeler l'API
#
# Prérequis: renseigner spotify_client_id et spotify_client_secret dans http-client.private.env.json

### 1. Obtenir un access token (Client Credentials)
# @name spotifyAuth
< {%
  const encoded = btoa(request.environment.get("spotify_client_id") + ":" + request.environment.get("spotify_client_secret"));
  request.variables.set("spotify_credentials_b64", encoded);
%}
POST https://accounts.spotify.com/api/token
Authorization: Basic {{spotify_credentials_b64}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials

> {%
  client.global.set("spotify_token", response.body.access_token);
  client.test("Token obtenu", function() {
    client.assert(response.status === 200, "Statut attendu 200");
    client.assert(response.body.access_token !== undefined, "access_token absent");
    client.assert(response.body.token_type === "Bearer", "token_type doit être Bearer");
  });
%}

>>! responses/response-token.json
###

### 2. Recherche track + artist — HUMBLE. (Kendrick Lamar)
GET https://api.spotify.com/v1/search?q=track:"HUMBLE."%20artist:"Kendrick%20Lamar"&type=track&limit=5&market=FR
Authorization: Bearer {{spotify_token}}

>>! responses/search.json

###

### 3. Recherche générique par titre seul
GET https://api.spotify.com/v1/search?q=track:"Blinding%20Lights"&type=track&limit=5&market=FR
Authorization: Bearer {{spotify_token}}

###

### 4. Recherche par titre + artiste + album
GET https://api.spotify.com/v1/search?q=track:"God's%20Plan"%20artist:"Drake"%20album:"Scorpion"&type=track&limit=5&market=FR
Authorization: Bearer {{spotify_token}}

###

### 5. Récupérer les audio features via ReccoBeats (Spotify audio-features est déprécié)
# Utilise le Spotify track ID — pas besoin d'auth
# Ex: 7KXjTSCq5nL1LoYtL7XAwS = HUMBLE. de Kendrick Lamar
GET https://api.reccobeats.com/v1/track/7KXjTSCq5nL1LoYtL7XAwS/audio-features

>>! responses/audio-features.json

###

### 5b. ReccoBeats audio features — Blinding Lights (The Weeknd)
# Ex: 0VjIjW4GlUZAMYd2vXMi3b
GET https://api.reccobeats.com/v1/track/0VjIjW4GlUZAMYd2vXMi3b/audio-features

###

### 6. Récupérer les infos complètes d'un track
GET https://api.spotify.com/v1/tracks/0VjIjW4GlUZAMYd2vXMi3b
Authorization: Bearer {{spotify_token}}

>>! responses/track_founded.json
