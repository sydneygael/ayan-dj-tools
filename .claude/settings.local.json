{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:www.discogs.com)",
      "WebFetch(domain:musicbrainz.org)",
      "Bash(./gradlew domain:test:*)",
      "Bash(./gradlew infra:test:*)",
      "Bash(./gradlew build:*)",
      "WebFetch(domain:reccobeats.com)",
      "Bash(flutter --version)",
      "Bash(flutter doctor:*)",
      "Bash(flutter create:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.aws/**)",
      "Read(./.gradle/**)",
      "Read(./.idea/**)",
      "Read(./.vscode/**)",
      "Read(./.ssh/**)",
      "Read(./.git/config)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
